# Public-safe example values for the prod environment.
# Copy to a local, untracked .tfvars file only if you choose to experiment manually.
# Do not commit real account IDs, backend settings, credentials, or secret values.

aws_region       = "us-east-1"
project_name     = "platform-infra-lab"
environment_name = "prod"

vpc_cidr             = "10.30.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.30.0.0/24", "10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.10.0/24", "10.30.11.0/24", "10.30.12.0/24"]

enable_nat_gateway            = true
log_retention_days            = 30
deletion_protection_enabled   = true
enable_redis                  = true
service_desired_count_default = 2

# ALB listener rules use module.load_balancer.http_listener_arn by default.
create_ecs_listener_rules = true
ecs_listener_arn          = null

load_balancer_internal                    = false
load_balancer_deletion_protection_enabled = true
load_balancer_http_listener_port          = 80
enable_load_balancer_https_listener       = false
load_balancer_https_listener_port         = 443
load_balancer_https_certificate_arn       = null
load_balancer_https_ssl_policy            = "ELBSecurityPolicy-2016-08"
load_balancer_access_logs_enabled         = false
load_balancer_access_logs_bucket          = null
load_balancer_access_logs_prefix          = null

# Secrets Manager references. Terraform creates metadata-only secret containers; values stay outside this repo.
secrets_manager_recovery_window_in_days = 30
secrets_manager_kms_key_id              = null

ecs_secret_definitions = {
  carbon-platform-api = {
    DATABASE_URL = {
      secret_name = "database-url"
      description = "Placeholder database URL reference for carbon-platform-api. The value is created outside this public repository."
    }
  }
  job-runner-platform = {
    JOB_RUNNER_API_KEY = {
      secret_name = "api-key"
      description = "Placeholder API key reference for job-runner-platform. The value is created outside this public repository."
    }
  }
  multi-tenant-saas-api = {
    DATABASE_URL = {
      secret_name = "database-url"
      description = "Placeholder database URL reference for multi-tenant-saas-api. The value is created outside this public repository."
    }
    JWT_SIGNING_KEY = {
      secret_name = "jwt-signing-key"
      description = "Placeholder JWT signing key reference for multi-tenant-saas-api. The value is created outside this public repository."
    }
  }
}

ecs_services = {
  carbon-platform-api = {
    image                       = "public.ecr.aws/example/carbon-platform-api:demo"
    container_port              = 8080
    cpu                         = 512
    memory                      = 1024
    desired_count               = 2
    health_check_path           = "/health"
    listener_rule_priority      = 110
    listener_rule_path_patterns = ["/carbon*", "/carbon/*"]
    environment_variables = {
      LOG_LEVEL     = "info"
      DATABASE_MODE = "placeholder"
    }
    secret_references = {}
    enable_autoscaling              = true
    autoscaling_min_capacity        = 2
    autoscaling_max_capacity        = 6
    autoscaling_cpu_target_value    = 55
    autoscaling_memory_target_value = 70
  }
  job-runner-platform = {
    image                       = "public.ecr.aws/example/job-runner-platform:demo"
    container_port              = 8080
    cpu                         = 512
    memory                      = 1024
    desired_count               = 2
    health_check_path           = "/healthz"
    listener_rule_priority      = 120
    listener_rule_path_patterns = ["/jobs*", "/jobs/*"]
    environment_variables = {
      LOG_LEVEL   = "info"
      WORKER_MODE = "demo"
      QUEUE_NAME  = "demo-jobs"
    }
    secret_references = {}
    enable_autoscaling              = true
    autoscaling_min_capacity        = 2
    autoscaling_max_capacity        = 4
    autoscaling_cpu_target_value    = 60
    autoscaling_memory_target_value = 75
  }
  multi-tenant-saas-api = {
    image                       = "public.ecr.aws/example/multi-tenant-saas-api:demo"
    container_port              = 8080
    cpu                         = 512
    memory                      = 1024
    desired_count               = 2
    health_check_path           = "/ready"
    listener_rule_priority      = 130
    listener_rule_path_patterns = ["/saas*", "/saas/*"]
    environment_variables = {
      LOG_LEVEL     = "info"
      TENANCY_MODE  = "demo"
      DATABASE_MODE = "placeholder"
    }
    secret_references = {}
    enable_autoscaling              = true
    autoscaling_min_capacity        = 2
    autoscaling_max_capacity        = 6
    autoscaling_cpu_target_value    = 55
    autoscaling_memory_target_value = 70
  }
}

alb_ingress_cidrs = ["0.0.0.0/0"]
alb_ingress_ports = [80]
service_port      = 8080
database_port     = 5432

rds_database_name                         = "appdb"
rds_master_username                       = "appadmin"
rds_engine_version                        = "16.3"
rds_instance_class                        = "db.t4g.small"
rds_allocated_storage_gib                 = 50
rds_max_allocated_storage_gib             = 200
rds_storage_type                          = "gp3"
rds_storage_encrypted                     = true
rds_storage_kms_key_id                    = null
rds_master_user_secret_kms_key_id         = null
rds_multi_az                              = true
rds_backup_retention_days                 = 14
rds_preferred_backup_window               = "03:00-04:00"
rds_preferred_maintenance_window          = "sun:04:00-sun:05:00"
rds_deletion_protection_enabled           = true
rds_skip_final_snapshot                   = false
rds_final_snapshot_identifier             = null
rds_delete_automated_backups              = false
rds_copy_tags_to_snapshot                 = true
rds_auto_minor_version_upgrade            = true
rds_apply_immediately                     = false
rds_enabled_cloudwatch_logs_exports       = ["postgresql", "upgrade"]
rds_monitoring_interval                   = 0
rds_monitoring_role_arn                   = null
rds_performance_insights_enabled          = true
rds_performance_insights_retention_period = 7
rds_performance_insights_kms_key_id       = null
rds_ca_cert_identifier                    = null

redis_port = 6379

# Optional Redis/Valkey cache. Prod enables it to show private cache and failover intent.
redis_engine                       = "redis"
redis_engine_version               = "7.1"
redis_node_type                    = "cache.t4g.small"
redis_parameter_group_name         = null
redis_replica_count                = 1
redis_automatic_failover_enabled   = true
redis_multi_az_enabled             = true
redis_at_rest_encryption_enabled   = true
redis_transit_encryption_enabled   = true
redis_kms_key_id                   = null
redis_snapshot_retention_days      = 7
redis_snapshot_window              = "04:00-05:00"
redis_final_snapshot_identifier    = "platform-infra-lab-prod-redis-final"
redis_maintenance_window           = "sun:05:00-sun:06:00"
redis_apply_immediately            = false
redis_auto_minor_version_upgrade   = true

# Observability examples. Alarm action lists stay empty because real routing ARNs belong outside this repo.
observability_alarm_actions             = []
observability_ok_actions                = []
observability_insufficient_data_actions = []
observability_dashboard_period_seconds  = 300
observability_alarm_period_seconds      = 300
alb_5xx_alarm_threshold                 = 5
alb_5xx_evaluation_periods              = 2
alb_unhealthy_target_threshold          = 1
alb_unhealthy_target_evaluation_periods = 2
ecs_cpu_alarm_threshold_percent         = 75
ecs_memory_alarm_threshold_percent      = 80
ecs_alarm_evaluation_periods            = 3
rds_cpu_alarm_threshold_percent         = 75
rds_free_storage_space_threshold_bytes  = 10737418240
rds_alarm_evaluation_periods            = 3

# Optional additional secret-reference scopes. Module-created Secrets Manager references feed the execution role automatically.
# Keep these empty in committed examples unless you are showing public-safe extra ARNs.
execution_secret_reference_arns = []
execution_ssm_parameter_arns    = []
execution_kms_key_arns          = []
task_secret_reference_arns      = []
task_ssm_parameter_arns         = []
task_kms_key_arns               = []

additional_tags = {
  Owner   = "portfolio-demo"
  CostUse = "production-intent-review"
}
